// Physical Constraints — Tang Nano 9K
// Bank 1 (3.3V): pin 52 (clk)
// Bank 3 (1.8V): pin 3 (S1 btn), pin 10-16 (LED0-LED5)

IO_LOC "clk"     52;   // 27 MHz oscillator — Bank 1
IO_LOC "rst_btn"  3;   // S1 button         — Bank 3
IO_LOC "led0"    10;   // LED0
IO_LOC "led1"    11;   // LED1
IO_LOC "led2"    12;   // LED2
IO_LOC "led3"    13;   // LED3
IO_LOC "led4"    15;   // LED4
IO_LOC "led5"    16;   // LED5

IO_PORT "clk"     PULL_MODE=NONE  IO_TYPE=LVCMOS33;
IO_PORT "rst_btn" PULL_MODE=UP    IO_TYPE=LVCMOS18;
IO_PORT "led0"    PULL_MODE=NONE  IO_TYPE=LVCMOS18  DRIVE=8;
IO_PORT "led1"    PULL_MODE=NONE  IO_TYPE=LVCMOS18  DRIVE=8;
IO_PORT "led2"    PULL_MODE=NONE  IO_TYPE=LVCMOS18  DRIVE=8;
IO_PORT "led3"    PULL_MODE=NONE  IO_TYPE=LVCMOS18  DRIVE=8;
IO_PORT "led4"    PULL_MODE=NONE  IO_TYPE=LVCMOS18  DRIVE=8;
IO_PORT "led5"    PULL_MODE=NONE  IO_TYPE=LVCMOS18  DRIVE=8;
